# === Baza de date ===
# Default: serverul PostgreSQL remote INDECO (vezi postgresconfig.md).
# Pentru Postgres local din Docker Compose (profil localdb):
#   postgresql://indeco:practica2026@localhost:5433/model
DATABASE_URL=postgresql://indeco:practica2026@192.168.101.60:5432/model

# === Servere Ollama (vezi MODELE-LOCALE-INDECO.md) ===
# .54 = L40 (rapid, singurul cu embeddings si OCR); .55 = DGX Spark (modele mari)
OLLAMA_URL_CHAT=http://192.168.100.54:11434
OLLAMA_URL_EMBED=http://192.168.100.54:11434
OLLAMA_URL_OCR=http://192.168.100.54:11434

# === Modele ===
CHAT_MODEL=gpt-oss:20b
EMBED_MODEL=bge-m3
# Dimensiunea vectorilor modelului de embedding (bge-m3 = 1024).
# ATENTIE: schimbarea modelului/dimensiunii cere reindexare completa (vezi README).
EMBED_DIM=1024
OCR_MODEL=glm-ocr

# === Documente ===
# Folderul scanat pentru PDF-uri (absolut sau relativ la radacina proiectului)
PDF_DIR=./documents

# === Parametri RAG ===
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
TOP_K_SEMANTIC=20
TOP_K_LEXICAL=20
TOP_N_CONTEXT=8

# === Server ===
PORT=3001
# Timeout apeluri Ollama (ms). Modelele mari pot dura; minim recomandat 300000.
OLLAMA_TIMEOUT_MS=300000
OLLAMA_KEEP_ALIVE=30m
